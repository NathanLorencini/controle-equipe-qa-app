{
  "name": "controle-equipe-qa-app",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "usuarios": "node server/usuarios.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "test": "node --test server/servidor.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "lucide-react": "^0.268.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.1.6",
    "vite": "^5.0.0"
  },
  "description": "Controle da equipe de QA: projetos, situacao e percentual de foco, com login, base compartilhada e exportacao para Excel e Word.",
  "type": "module"
}
